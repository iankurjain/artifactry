{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifact-library",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],

  // ---------------------------------------------------------------
  // D1 — metadata, RBAC, shares, analytics (PRD §62, §94)
  // ---------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artifact-library-production",
      "database_id": "10cb7bc6-41c5-4c9d-8788-6d1896531fd5"
    }
  ],

  // ---------------------------------------------------------------
  // R2 — original artifacts, versions, previews (PRD §62, §65)
  // ---------------------------------------------------------------
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "artifact-library-bucket"
    }
  ],

  // ---------------------------------------------------------------
  // Vectorize — semantic search index (PRD §31, §32)
  //
  // Index contract:
  //   name        artifact-library-embeddings
  //   dimensions  768
  //   metric      cosine
  //   model       @cf/baai/bge-base-en-v1.5   (see EMBEDDING_MODEL)
  //
  // The dimension count here MUST match EMBEDDING_DIMENSIONS in
  // src/lib/embeddings.ts, or every upsert is rejected at runtime.
  // ---------------------------------------------------------------
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "artifact-library-embeddings"
    }
  ],

  // Workers AI — embedding generation (PRD §31)
  "ai": {
    "binding": "AI"
  },

  "vars": {
    "APP_NAME": "Artifactry",
    // Sender identity for transactional email (Resend).
    //
    // artifactry.app is verified on the Resend account with sending enabled
    // (DKIM at resend._domainkey, SPF via the rsend/send CNAMEs), so the
    // library sends as no-reply@artifactry.app. Sign-in codes therefore reach
    // any recipient, not only the address that owns the Resend account.
    //
    // Changing this line requires a redeploy: EMAIL_FROM is a build-time var,
    // not a runtime secret.
    "EMAIL_FROM": "Artifactry <no-reply@artifactry.app>",
    // Server-side enforced upload ceilings (PRD §9). Worker-proxied uploads,
    // so this is bounded by the Workers request body limit.
    "MAX_UPLOAD_BYTES": "26214400",

    // ---------------------------------------------------------------
    // Interactive HTML preview origin
    //
    // The isolated origin that serves script-executing HTML artifacts. It MUST
    // be a different hostname from the application: cookies are host-only and
    // localStorage is per-origin, so a distinct host is what actually isolates
    // an artifact from the session.
    //
    // Enabling Interactive Preview additionally requires the matching signing
    // secret, which is NOT here — it is set out-of-band:
    //
    //   wrangler pages secret put PREVIEW_TOKEN_SECRET --project-name artifact-library
    //
    // With the secret unset, Interactive Preview is UNAVAILABLE and every HTML
    // artifact renders in Safe Preview (JavaScript disabled). That is the
    // intended fail-closed default: the architecture ships wired, and turning
    // script execution on is a deliberate operator action.
    //
    // The Preview origin must also have DNS + a Pages custom domain pointed at
    // this project before the value below can resolve.
    "PREVIEW_ORIGIN": "https://preview.artifactry.app",

    // ---------------------------------------------------------------
    // Canonical application origin
    //
    // The app origin is what mints preview tokens, and each token carries the
    // origin permitted to frame the document (`frame-ancestors`). The preview
    // surface refuses a token whose signed origin does not match this value, so
    // a request arriving with a spoofed Host header cannot choose an arbitrary
    // framer. Set here (not derived from the request) so the expected value is
    // fixed configuration rather than attacker-influenced input.
    "APP_ORIGIN": "https://artifactry.app"
  }

  // NOTE (BYOK path only): kv_namespaces and triggers are permitted here,
  // but this build keeps all state in D1 + R2 so the same source also
  // deploys on the hosted path if ever needed.
}
