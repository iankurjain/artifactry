{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=artifact-library-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "build:all": "npm run build && npm run build:preview",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name artifact-library --branch main",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "dev:preview": "bash scripts/dev-preview-worker.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s http://localhost:3000/api/health",
    "test:gates": "bash scripts/run-gates.sh",
    "test:preview": "node scripts/test-preview.mjs",
    "test:preview:security": "node scripts/test-preview-security.mjs",
    "test:preview:ui": "node scripts/test-preview-ui.mjs",
    "test:production": "node scripts/test-production.mjs",
    "db:migrate:local": "wrangler d1 migrations apply artifact-library-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply artifact-library-production",
    "db:seed": "wrangler d1 execute artifact-library-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute artifact-library-production --local",
    "db:console:prod": "wrangler d1 execute artifact-library-production",
    "git:status": "git status --short",
    "git:log": "git log --oneline -12"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "playwright": "^1.63.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
